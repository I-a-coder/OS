#include <stdio.h>
#include <stdlib.h>
#include <fcntl.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <unistd.h>
#include <time.h>
#include <string.h>

#define FIFO_NAME "/tmp/my_fifo"
#define NUM_MESSAGES 1000000
#define BUFFER_SIZE 256

int main() {
    int fd;
    char buffer[BUFFER_SIZE];
    struct timespec start, end;
    double elapsed_time;
    int messages_sent = 0;
    
    // Create FIFO if it doesn't exist
    mkfifo(FIFO_NAME, 0666);
    
    printf("FIFO Writer: Opening FIFO for writing...\n");
    
    // Open FIFO for writing
    fd = open(FIFO_NAME, O_WRONLY);
    if (fd == -1) {
        perror("open failed");
        return 1;
    }
    
    printf("FIFO Writer: Starting to send messages...\n");
    
    // Prepare message
    strcpy(buffer, "Hello from FIFO writer");
    
    // Start timing
    clock_gettime(CLOCK_MONOTONIC, &start);
    
    // Write messages
    for (int i = 0; i < NUM_MESSAGES; i++) {
        ssize_t bytes_written = write(fd, buffer, strlen(buffer) + 1);
        if (bytes_written > 0) {
            messages_sent++;
        } else {
            perror("write failed");
            break;
        }
    }
    
    // End timing
    clock_gettime(CLOCK_MONOTONIC, &end);
    
    // Calculate elapsed time
    elapsed_time = (end.tv_sec - start.tv_sec) + 
                   (end.tv_nsec - start.tv_nsec) / 1e9;
    
    printf("\n=== FIFO Writer Statistics ===\n");
    printf("Messages sent: %d\n", messages_sent);
    printf("Total time: %.6f seconds\n", elapsed_time);
    printf("Average time per message: %.9f seconds\n", 
           elapsed_time / messages_sent);
    printf("Messages per second: %.2f\n", messages_sent / elapsed_time);
    
    close(fd);
    
    return 0;
}
