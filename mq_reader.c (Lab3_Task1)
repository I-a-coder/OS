#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <mqueue.h>
#include <time.h>
#include <fcntl.h>
#include <sys/stat.h>
#include <unistd.h>

#define MQ_NAME "/my_message_queue"
#define NUM_MESSAGES 1000000
#define MSG_SIZE 256
#define MAX_MSGS 10

int main() {
    mqd_t mq;
    char buffer[MSG_SIZE];
    struct mq_attr attr;
    struct timespec start, end;
    double elapsed_time;
    int messages_received = 0;
    
    // Set message queue attributes
    attr.mq_flags = 0;
    attr.mq_maxmsg = MAX_MSGS;
    attr.mq_msgsize = MSG_SIZE;
    attr.mq_curmsgs = 0;
    
    printf("MQ Reader: Opening message queue...\n");
    
    // Open message queue
    mq = mq_open(MQ_NAME, O_CREAT | O_RDONLY, 0644, &attr);
    if (mq == (mqd_t)-1) {
        perror("mq_open failed");
        return 1;
    }
    
    printf("MQ Reader: Starting to receive messages...\n");
    
    // Start timing
    clock_gettime(CLOCK_MONOTONIC, &start);
    
    // Receive messages
    for (int i = 0; i < NUM_MESSAGES; i++) {
        ssize_t bytes_read = mq_receive(mq, buffer, MSG_SIZE, NULL);
        if (bytes_read >= 0) {
            messages_received++;
        } else {
            perror("mq_receive failed");
            break;
        }
    }
    
    // End timing
    clock_gettime(CLOCK_MONOTONIC, &end);
    
    // Calculate elapsed time
    elapsed_time = (end.tv_sec - start.tv_sec) + 
                   (end.tv_nsec - start.tv_nsec) / 1e9;
    
    printf("\n=== Message Queue Reader Statistics ===\n");
    printf("Messages received: %d\n", messages_received);
    printf("Total time: %.6f seconds\n", elapsed_time);
    printf("Average time per message: %.9f seconds\n", 
           elapsed_time / messages_received);
    printf("Messages per second: %.2f\n", messages_received / elapsed_time);
    
    mq_close(mq);
    mq_unlink(MQ_NAME);
    
    return 0;
}
