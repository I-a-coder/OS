#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <mqueue.h>
#include <time.h>
#include <fcntl.h>
#include <sys/stat.h>
#include <unistd.h>

#define MQ_NAME "/my_message_queue"
#define NUM_MESSAGES 1000000
#define MSG_SIZE 256
#define MAX_MSGS 10

int main() {
    mqd_t mq;
    char buffer[MSG_SIZE];
    struct mq_attr attr;
    struct timespec start, end;
    double elapsed_time;
    int messages_sent = 0;
    
    // Set message queue attributes
    attr.mq_flags = 0;
    attr.mq_maxmsg = MAX_MSGS;
    attr.mq_msgsize = MSG_SIZE;
    attr.mq_curmsgs = 0;
    
    printf("MQ Writer: Opening message queue...\n");
    
    // Open message queue
    mq = mq_open(MQ_NAME, O_CREAT | O_WRONLY, 0644, &attr);
    if (mq == (mqd_t)-1) {
        perror("mq_open failed");
        return 1;
    }
    
    printf("MQ Writer: Starting to send messages...\n");
    
    // Prepare message
    strcpy(buffer, "Hello from MQ writer");
    
    // Start timing
    clock_gettime(CLOCK_MONOTONIC, &start);
    
    // Send messages
    for (int i = 0; i < NUM_MESSAGES; i++) {
        if (mq_send(mq, buffer, strlen(buffer) + 1, 0) == 0) {
            messages_sent++;
        } else {
            perror("mq_send failed");
            break;
        }
    }
    
    // End timing
    clock_gettime(CLOCK_MONOTONIC, &end);
    
    // Calculate elapsed time
    elapsed_time = (end.tv_sec - start.tv_sec) + 
                   (end.tv_nsec - start.tv_nsec) / 1e9;
    
    printf("\n=== Message Queue Writer Statistics ===\n");
    printf("Messages sent: %d\n", messages_sent);
    printf("Total time: %.6f seconds\n", elapsed_time);
    printf("Average time per message: %.9f seconds\n", 
           elapsed_time / messages_sent);
    printf("Messages per second: %.2f\n", messages_sent / elapsed_time);
    
    mq_close(mq);
    
    return 0;
}
