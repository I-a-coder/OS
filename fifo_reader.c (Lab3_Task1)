#include <stdio.h>
#include <stdlib.h>
#include <fcntl.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <unistd.h>
#include <time.h>
#include <string.h>

#define FIFO_NAME "/tmp/my_fifo"
#define NUM_MESSAGES 1000000
#define BUFFER_SIZE 256

int main() {
    int fd;
    char buffer[BUFFER_SIZE];
    struct timespec start, end;
    double elapsed_time;
    int messages_received = 0;
    
    // Create FIFO if it doesn't exist
    mkfifo(FIFO_NAME, 0666);
    
    printf("FIFO Reader: Opening FIFO for reading...\n");
    
    // Open FIFO for reading
    fd = open(FIFO_NAME, O_RDONLY);
    if (fd == -1) {
        perror("open failed");
        return 1;
    }
    
    printf("FIFO Reader: Starting to receive messages...\n");
    
    // Start timing
    clock_gettime(CLOCK_MONOTONIC, &start);
    
    // Read messages
    for (int i = 0; i < NUM_MESSAGES; i++) {
        ssize_t bytes_read = read(fd, buffer, BUFFER_SIZE);
        if (bytes_read > 0) {
            messages_received++;
        } else if (bytes_read == 0) {
            printf("FIFO Reader: Writer closed the pipe\n");
            break;
        } else {
            perror("read failed");
            break;
        }
    }
    
    // End timing
    clock_gettime(CLOCK_MONOTONIC, &end);
    
    // Calculate elapsed time
    elapsed_time = (end.tv_sec - start.tv_sec) + 
                   (end.tv_nsec - start.tv_nsec) / 1e9;
    
    printf("\n=== FIFO Reader Statistics ===\n");
    printf("Messages received: %d\n", messages_received);
    printf("Total time: %.6f seconds\n", elapsed_time);
    printf("Average time per message: %.9f seconds\n", 
           elapsed_time / messages_received);
    printf("Messages per second: %.2f\n", messages_received / elapsed_time);
    
    close(fd);
    unlink(FIFO_NAME);
    
    return 0;
}
