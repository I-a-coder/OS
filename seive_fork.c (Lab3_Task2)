#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>
#include <time.h>

#define MAX_NUM 1000

// Function to filter numbers through a pipe-based sieve
void sieve_process(int read_fd) {
    int prime, number;
    int pipe_fd[2];
    pid_t pid;
    
    // Read the first number (which is prime)
    if (read(read_fd, &prime, sizeof(int)) <= 0) {
        close(read_fd);
        return;
    }
    
    printf("%d ", prime);
    fflush(stdout);
    
    // Create pipe for next process
    if (pipe(pipe_fd) == -1) {
        perror("pipe failed");
        exit(1);
    }
    
    // Fork a child process
    pid = fork();
    
    if (pid == -1) {
        perror("fork failed");
        exit(1);
    }
    
    if (pid == 0) {
        // Child process
        close(pipe_fd[1]); // Close write end
        close(read_fd);    // Close parent's read end
        sieve_process(pipe_fd[0]);
        close(pipe_fd[0]);
        exit(0);
    } else {
        // Parent process
        close(pipe_fd[0]); // Close read end
        
        // Read numbers and pass non-multiples to child
        while (read(read_fd, &number, sizeof(int)) > 0) {
            if (number % prime != 0) {
                write(pipe_fd[1], &number, sizeof(int));
            }
        }
        
        close(read_fd);
        close(pipe_fd[1]);
        
        // Wait for child to finish
        wait(NULL);
    }
}

int main() {
    int pipe_fd[2];
    pid_t pid;
    struct timespec start, end;
    double elapsed_time;
    
    printf("=== Sieve of Eratosthenes - Fork Version with Pipes ===\n");
    printf("Finding all prime numbers from 2 to %d\n\n", MAX_NUM);
    printf("Prime numbers: ");
    fflush(stdout);
    
    // Start timing
    clock_gettime(CLOCK_MONOTONIC, &start);
    
    // Create initial pipe
    if (pipe(pipe_fd) == -1) {
        perror("pipe failed");
        return 1;
    }
    
    // Fork first child
    pid = fork();
    
    if (pid == -1) {
        perror("fork failed");
        return 1;
    }
    
    if (pid == 0) {
        // Child process - start the sieve chain
        close(pipe_fd[1]); // Close write end
        sieve_process(pipe_fd[0]);
        close(pipe_fd[0]);
        exit(0);
    } else {
        // Parent process - generate numbers
        close(pipe_fd[0]); // Close read end
        
        // Send all numbers from 2 to MAX_NUM
        for (int i = 2; i <= MAX_NUM; i++) {
            write(pipe_fd[1], &i, sizeof(int));
        }
        
        close(pipe_fd[1]);
        
        // Wait for child processes to finish
        wait(NULL);
    }
    
    // End timing
    clock_gettime(CLOCK_MONOTONIC, &end);
    
    // Calculate elapsed time
    elapsed_time = (end.tv_sec - start.tv_sec) + 
                   (end.tv_nsec - start.tv_nsec) / 1e9;
    
    printf("\n\n=== Performance Statistics ===\n");
    printf("Total execution time: %.9f seconds\n", elapsed_time);
    
    return 0;
}
